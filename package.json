{
  "name": "zak-mcp-gateway",
  "version": "0.4.0",
  "description": "Universal Token-Optimized Model Context Protocol (TO-MCP) Gateway & Middleware Proxy",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "zak-mcp-gateway": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "pretest": "npm run build",
    "test": "node --import tsx --test tests/unit.test.mjs tests/integration.test.mjs tests/features.test.mjs tests/agent-ui-harness.test.ts",
    "test:github": "node tests/test-github-live.mjs",
    "bench:github": "node tests/benchmark-github.mjs",
    "report": "node dist/cli.js report",
    "bench:compare": "node tests/benchmark-compare.mjs --prev"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "token-optimization",
    "llm",
    "agent",
    "gateway",
    "proxy"
  ],
  "author": "skzak",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "minisearch": "^7.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "js-tiktoken": "^1.0.21",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
