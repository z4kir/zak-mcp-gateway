{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Gateway Server (Dev - tsx)",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--import", "tsx"],
      "program": "${workspaceFolder}/src/cli.ts",
      "args": ["--config", "${workspaceFolder}/config/servers.json"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Gateway Server (Built - dist/cli.js)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/dist/cli.js",
      "args": ["--config", "${workspaceFolder}/config/servers.json"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build Gateway (tsc)",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Gateway Server (Dev - Example Config)",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--import", "tsx"],
      "program": "${workspaceFolder}/src/cli.ts",
      "args": ["--config", "${workspaceFolder}/config/servers.example.json"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Agent UI Server (Next.js Dev)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/agent-ui",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "./node_modules/next/dist/bin/next",
        "dev",
        "--port",
        "3000"
      ],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "started server on .+, url: (https?://.+)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Agent UI Server (Next.js Start - Production)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/agent-ui",
      "preLaunchTask": "Build Agent UI (Next.js)",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "./node_modules/next/dist/bin/next",
        "start",
        "--port",
        "3000"
      ],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "started server on .+, url: (https?://.+)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Mock MCP Server (Stdio Test)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/tests/mock-server.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Downstream: Filesystem (MCP Server)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "windows": {
        "runtimeExecutable": "npx.cmd"
      },
      "runtimeArgs": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${workspaceFolder}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Downstream: GitHub (MCP Server)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "windows": {
        "runtimeExecutable": "npx.cmd"
      },
      "runtimeArgs": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Downstream: Postgres (MCP Server)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "windows": {
        "runtimeExecutable": "npx.cmd"
      },
      "runtimeArgs": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://user:password@localhost/mydb"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Downstream: Slack (MCP Server)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "windows": {
        "runtimeExecutable": "npx.cmd"
      },
      "runtimeArgs": [
        "-y",
        "@modelcontextprotocol/server-slack"
      ],
      "env": {
        "SLACK_BOT_TOKEN": "${env:SLACK_BOT_TOKEN}"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: Gateway (Dev) + Agent UI",
      "configurations": [
        "Gateway Server (Dev - tsx)",
        "Agent UI Server (Next.js Dev)"
      ],
      "stopAll": true
    },
    {
      "name": "Full Stack: Gateway (Built) + Agent UI",
      "configurations": [
        "Gateway Server (Built - dist/cli.js)",
        "Agent UI Server (Next.js Dev)"
      ],
      "stopAll": true
    }
  ]
}
